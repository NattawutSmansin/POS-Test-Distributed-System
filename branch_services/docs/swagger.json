        "version": "1.0"
    },
    "host": "localhost:5566",
    "basePath": "/",
    "paths": {
        "/api/branch/orders": {
            "post": {
                "description": "2.2 POST /orders – ทำรายการขายสินค้า",
                "tags": [
                    "Branch Services"
                ],
                "operationId": "CreateOrder",
                "parameters": [
                    {
                        "description": "body",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/requests.OrderReport"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.Success"
                        }
                    },
                    "409": {
                        "description": "Conflict Error"
                    },
                    "422": {
                        "description": "Entity Error"
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/responses.InternalServerErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/branch/{branch_id}/products": {
            "get": {
                "description": "2.1 GET /products – แสดงข้อมูลสินค้าทั้งหมดของสาขา",
                "tags": [
                    "Branch Services"
                ],
                "operationId": "BranchProduct",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID สาขา",
                        "name": "branch_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/responses.Success"
                        }
                    },
                    "409": {
                        "description": "Conflict Error"
                    },
                    "422": {
                        "description": "Entity Error"
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/responses.InternalServerErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "requests.OrderReport": {
            "type": "object",
            "properties": {
                "branch_id": {
                    "type": "integer"
                },
                "price": {
                    "type": "number"
                },
                "product_id": {
                    "type": "integer"
                },
                "qty": {
                    "type": "integer"
                },
                "total": {
                    "type": "number"
                }
            }
        },
        "responses.InternalServerErrorResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "boolean",
                    "x-order": "0",
                    "example": false
                },
                "code": {
                    "type": "integer",
                    "x-order": "1",
                    "example": 500
                },
                "error": {
                    "type": "object",
                    "properties": {
                        "message": {
                            "type": "string",
                            "x-order": "0",
                            "example": "internal server error"
                        },
                        "field": {
                            "type": "object",
                            "x-order": "1"
                        }
                    },
                    "x-order": "2"
                }
            }
        },
        "responses.Success": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "boolean",
                    "x-order": "0",
                    "example": true
                },
                "code": {
                    "type": "integer",
                    "x-order": "1"
                },
                "data": {
                    "x-order": "2"
                }
            }
        }
    }
